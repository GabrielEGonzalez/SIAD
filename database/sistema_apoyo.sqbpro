ot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="68"/><column index="2" value="63"/><column index="3" value="64"/><column index="4" value="56"/><column index="5" value="81"/><column index="6" value="39"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">
CREATE TABLE direccion(
    idDireccion INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
    calle TEXT,                      -- Corregido: VARCHAR(150) -&gt; TEXT
    provincia TEXT,
    referencia TEXT
);

CREATE TABLE
    contacto (
        idContacto INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        telefonoResidencial TEXT,       -- Corregido: VARCHAR(20) -&gt; TEXT
        telefonoOficina TEXT,
        celular TEXT,
        correoElectronico TEXT
    );


CREATE TABLE
    informacion_laboral (
        idLaboral INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        unidadAdministrativa TEXT,
        departamento TEXT,
        cargo TEXT,
        condicion TEXT, -- Corregido: ENUM -&gt; TEXT
        tiempoServicio TEXT,
        salarioBruto REAL,  -- Corregido: DECIMAL(10, 2) -&gt; REAL
        salarioNeto REAL,   -- Corregido: DECIMAL(10, 2) -&gt; REAL
        fechaInicio DATE,
        ultimoNivelAcademico TEXT,
        profesion TEXT
    );


CREATE TABLE
    persona (
        id_persona INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        nombre TEXT NOT NULL,
        apellido TEXT NOT NULL,
        edad INTEGER,
        tipo TEXT NOT NULL -- Corregido: ENUM -&gt; TEXT
    );


CREATE TABLE
    funcionario (
        idFuncionario INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        id_persona INTEGER,
        fechaNacimiento DATE,
        cedula INTEGER NOT NULL UNIQUE,
        estadoCivil TEXT,
        idDireccion INTEGER,
        idContacto INTEGER,
        idLaboral INTEGER,
        trabajadorSocial TEXT,
        firma TEXT,
        FOREIGN KEY (idDireccion) REFERENCES direccion (idDireccion) ON DELETE SET NULL,
        -- NOTA: La FK id_persona referenciaba a direccion.id_persona, lo he cambiado a persona.id_persona
        FOREIGN KEY (id_persona) REFERENCES persona (id_persona) ON DELETE SET NULL, 
        FOREIGN KEY (idContacto) REFERENCES contacto (idContacto) ON DELETE SET NULL,
        FOREIGN KEY (idLaboral) REFERENCES informacion_laboral (idLaboral) ON DELETE SET NULL
    );


CREATE TABLE
    informacion_familiar_funcionario (
        idInfoFam INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        idFuncionario INTEGER NOT NULL,
        dependientesAsegurados TEXT DEFAULT 'no', -- Corregido: ENUM -&gt; TEXT
        quienesNoAsegurados TEXT,
        familiarDiscapacitado TEXT DEFAULT 'no',  -- Corregido: ENUM -&gt; TEXT
        cualDiscapacidad TEXT,
        FOREIGN KEY (idFuncionario) REFERENCES funcionario (idFuncionario) ON DELETE CASCADE
    );


CREATE TABLE
    composicion_familiar_funcionario (
        idFamiliar INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        idFuncionario INTEGER NOT NULL,
        nombre TEXT,
        parentesco TEXT,
        sexo TEXT, -- Corregido: ENUM -&gt; TEXT
        edad INTEGER,
        nivelEducativo TEXT,
        lugarTrabajoEstudio TEXT,
        salario REAL, -- Corregido: DECIMAL(10, 2) -&gt; REAL
        FOREIGN KEY (idFuncionario) REFERENCES funcionario (idFuncionario) ON DELETE CASCADE
    );


CREATE TABLE
    tipo_solicitud (
        idSolicitud INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        idFuncionario INTEGER NOT NULL,
        tipo TEXT,                      -- Corregido: ENUM -&gt; TEXT
        nombreReferente TEXT,
        telefonoReferente TEXT,
        FOREIGN KEY (idFuncionario) REFERENCES funcionario (idFuncionario) ON DELETE CASCADE
    );


CREATE TABLE
    discapacidad (
        idDiscapacidad INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        tipoDiscapacidad TEXT,
        tiempoDiscapacidad TEXT
    );


CREATE TABLE
    declaraciondiscapacidad (
        idDeclaracionDiscap INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        diagnostico TEXT,
        dificultad TEXT,
        certificado TEXT,                     -- Corregido: ENUM -&gt; TEXT
        estadoCertificado TEXT
    );


CREATE TABLE
    situacioneconomica (
        idSituacionEconomica INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        trabaja TEXT,                          -- Corregido: ENUM -&gt; TEXT
        especificacion TEXT,
        telefono TEXT,
        parentesco TEXT
    );


CREATE TABLE
    situacionsalud (
        idSalud INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        telefono TEXT,
        especifique TEXT,
        parentesco TEXT,
        recibeTerapia TEXT -- Corregido: ENUM -&gt; TEXT
    );

CREATE TABLE
    situacionacademica (
        idSituacionAcademica INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        facultad TEXT,
        carrera TEXT,
        anioIngreso INTEGER,    -- Corregido: YEAR -&gt; INTEGER
        anioCursa INTEGER
    );


CREATE TABLE
    estudiante (
        idCedula INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        id_persona INTEGER,
        idDireccion INTEGER,
        correo_electronico TEXT,
        telefonoContactoFijo TEXT,
        telefonoContactoCelular TEXT,
        id_discapacidad INTEGER,
        id_situacionEconomica INTEGER,
        id_salud INTEGER,
        comentarioAdicional TEXT,
        observaciones_recomendaciones TEXT,
        firma_encargado TEXT,
        id_situacionAcademica INTEGER,
        idDeclaracionDiscapacidad INTEGER,
        FOREIGN KEY (idDireccion) REFERENCES direccion (idDireccion) ON DELETE SET NULL,
        FOREIGN KEY (id_discapacidad) REFERENCES discapacidad (idDiscapacidad) ON DELETE SET NULL,
        FOREIGN KEY (id_situacionEconomica) REFERENCES situacioneconomica (idSituacionEconomica) ON DELETE SET NULL,
        FOREIGN KEY (id_salud) REFERENCES situacionsalud (idSalud) ON DELETE SET NULL,
        FOREIGN KEY (id_persona) REFERENCES persona (id_persona) ON DELETE SET NULL,
        FOREIGN KEY (id_situacionAcademica) REFERENCES situacionacademica (idSituacionAcademica) ON DELETE SET NULL,
        FOREIGN KEY (idDeclaracionDiscapacidad) REFERENCES declaraciondiscapacidad (idDeclaracionDiscap) ON DELETE SET NULL
    );


CREATE TABLE casos (
    id_casos INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
    descripcion TEXT,
    fechaRegistro DATE DEFAULT CURRENT_DATE
);

CREATE TABLE caso_persona (
    idCasoPersona INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
    id_caso INTEGER NOT NULL,
    id_persona INTEGER NOT NULL,
    tipo TEXT NOT NULL,                -- Corregido: ENUM -&gt; TEXT
    FOREIGN KEY (id_caso) REFERENCES casos (id_casos) ON DELETE CASCADE,
    FOREIGN KEY (id_persona) REFERENCES persona (id_persona) ON DELETE CASCADE
);


CREATE TABLE
    cronica_funcionario (
        id INTEGER PRIMARY KEY,     -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        id_caso INTEGER NOT NULL,
        id_funcionario INTEGER NOT NULL,
        relato TEXT NOT NULL,
        elaborado_por TEXT NOT NULL,
        cargo TEXT DEFAULT 'Trabajador Social L.P.',
        fecha_elaboracion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY (id_caso) REFERENCES casos (id_casos) ON DELETE CASCADE,
        FOREIGN KEY (id_funcionario) REFERENCES funcionario (idFuncionario) ON DELETE CASCADE
    );


CREATE TABLE
    seguimiento (
        idSeguimiento INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        id_estudiante INTEGER,
        id_caso INTEGER,
        ayudaTecnica TEXT,
        remitido TEXT,                     -- Corregido: ENUM -&gt; TEXT
        motivo_ss TEXT,
        accionesSeguridadR TEXT,
        observaciones TEXT,
        firma_user TEXT,
        fecha DATE,
        responsableSeguimiento TEXT,
        FOREIGN KEY (id_estudiante) REFERENCES estudiante (idCedula) ON DELETE SET NULL,
        FOREIGN KEY (id_caso) REFERENCES casos (id_casos) ON DELETE CASCADE
    );


CREATE TABLE
    usuario (
        idCedula INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        nombre TEXT NOT NULL,
        apellido TEXT NOT NULL,
        correo TEXT NOT NULL UNIQUE,
        contraseña TEXT NOT NULL,
        rol TEXT NOT NULL -- Corregido: ENUM -&gt; TEXT
    );


CREATE TABLE
    auditoria (
        idAuditoria INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
        idUsuario INTEGER,
        fechaEntrada DATETIME,
        fechaSalida DATETIME,
        FOREIGN KEY (idUsuario) REFERENCES usuario (idCedula) ON DELETE SET NULL
    );


CREATE TABLE interconsulta (
    idInterconsulta INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
    idCaso INTEGER NOT NULL,
    idUsuarioDestino INTEGER NOT NULL,
    idUsuarioAdmin INTEGER NOT NULL,
    motivo TEXT NOT NULL,
    observaciones TEXT,
    fecha_creacion DATETIME DEFAULT CURRENT_TIMESTAMP,
    estado TEXT DEFAULT 'pendiente', -- Corregido: ENUM -&gt; TEXT
    FOREIGN KEY (idCaso) REFERENCES casos(id_casos), -- Asumo que se refiere a la tabla 'casos'
    FOREIGN KEY (idUsuarioDestino) REFERENCES usuario(idCedula),
    FOREIGN KEY (idUsuarioAdmin) REFERENCES usuario(idCedula)
);

CREATE TABLE cita (
    idCita INTEGER PRIMARY KEY, -- Corregido: AUTO_INCREMENT -&gt; INTEGER PRIMARY KEY
    titulo TEXT NOT NULL,
    descripcion TEXT,
    fecha_hora DATETIME NOT NULL,
    tipo TEXT DEFAULT 'cita', -- Corregido: ENUM -&gt; TEXT
    idPersona INTEGER NULL,
    idUsuario INTEGER NULL,
    idCaso INTEGER NULL,
    prioridad TEXT DEFAULT 'media', -- Corregido: ENUM -&gt; TEXT
    estado TEXT DEFAULT 'pendiente', -- Corregido: ENUM -&gt; TEXT
    FOREIGN KEY (idPersona) REFERENCES persona(id_persona), -- Corregido: Usar id_persona de la tabla persona
    FOREIGN KEY (idUsuario) REFERENCES usuario(idCedula),
    FOREIGN KEY (idCaso) REFERENCES casos(id_casos) -- Asumo que se refiere a la tabla 'casos'
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
